const registry: { [class<Plugin>]: true? } = {}

trait Plugin
    expect function name(): string

    function greet(self): string
        return `plugin:{self:name()}`
    end

    function __create(wanted: string): Plugin
        for cls in registry do
            if cls.name() == wanted then
                return cls()
            end
        end
        return error(`missing plugin {wanted}`, 2)
    end

    final function __implemented(cls: class<Plugin>)
        registry[cls] = true
    end
end

class Alpha implements Plugin
    function name(): string
        return "alpha"
    end
end

class Beta implements Plugin
    function name(): string
        return "beta"
    end
end

class Gamma implements Plugin
    function name(): string
        return "alpha"
    end
end

for _, wanted in { "alpha", "beta" } do
    print(Plugin(wanted):greet())
end

const alpha_ok, alpha_value = pcall(function()
    return Plugin("missing")
end)
print(alpha_ok, type(alpha_value))

const alpha_first = Plugin("alpha")
print(class.isinstance(alpha_first, Alpha), class.isinstance(alpha_first, Gamma))
print(class.implements(alpha_first, Plugin))
