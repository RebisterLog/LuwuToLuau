trait Vector
    function __eq(self, other): boolean
        return self.x == other.x and self.y == other.y
    end

    function __tostring(self): string
        return `({self.x}, {self.y})`
    end

    function length(self): number
        return math.sqrt(self.x * self.x + self.y * self.y)
    end
end

class Point(x: number, y: number) implements Vector
    function __add(self, other: Point): Point
        return Point(self.x + other.x, self.y + other.y)
    end
end

class FrozenPoint(x: number, y: number) implements Vector end

const a = Point(3, 4)
const b = Point(1, 2)
const c = FrozenPoint(3, 4)

print(a, b, a + b)
print(a == Point(3, 4), a == b, c == FrozenPoint(3, 4), c == a)
print(a:length(), c:length())
print(class.of(a) == Point, class.of(a) == FrozenPoint, class.of({}))
print(class.name(a), class.name(FrozenPoint()))

for _, field in class.fields(FrozenPoint()) do
    print(field.name, field.position)
end

print(class.member(a, "x").name, class.member(Point, "length").kind)
