class Account(
    public const owner: string,
    public balance: number = 0,
    private rate: number = 1.5
)
    public const kind = "account"
    public display = string.upper(owner) .. " (" .. tostring(balance) .. ")"
    public history: { number } = {}

    public function deposit(self, amount: number): number
        self.balance += amount * self.rate
        table.insert(self.history, amount)
        return self.balance
    end

    public function describe(self): string
        return `{self.display}: {self.balance}`
    end

    public static function zero(owner: string): Account
        return Account(owner)
    end
end

const ada = Account("Ada", 10, 2)
print(ada:deposit(5), ada.balance, ada.kind)
print(ada:describe())
print(#ada.history, ada.history[1])

const bob = Account.zero("Bob")
print(bob.balance, bob:describe())

print(class.isinstance(ada, Account), class.isinstance("x", Account))
print(class.name(Account), class.name(ada))

for _, field in class.fields(ada) do
    print(field.name, field.position, field.isconst)
end

print(#class.fields(ada))
print(class.member(Account, "deposit").name)
print(class.member(ada, "owner"))
