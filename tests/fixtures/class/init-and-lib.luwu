class Point
    x: number
    y: number
    label: string = "point"

    function __init(self, text: string)
        const x, y = string.match(text, "^(%-?%d+),(%-?%d+)$")
        self.x = tonumber(x) or 0
        self.y = tonumber(y) or 0
    end

    function moved(self, dx: number, dy: number): Point
        return Point(`{self.x + dx},{self.y + dy}`)
    end

    function shifted(self): Point
        return self:moved(1, 1)
    end
end

const p = Point("3,4")
print(p.x, p.y, p.label)

const broken = Point("not a point")
print(broken.x, broken.y, broken.label)

const q = p:moved(1, 1)
print(q.x, q.y, q.label)

const r = p:shifted()
print(r.x, r.y)

print(class.isinstance(p, Point), class.isinstance(p, {}))
print(class.name(p), class.name(Point))

for _, field in class.fields(p) do
    print(field.name, field.value:get())
end

print(class.member(p, "label").name, class.member(Point, "moved").kind)
