class Config
    public const name = "default"
    public retries = 3
    public tags: { string } = { "base" }
end

class Service(config: Config)
    public config = config
    public attempts = 0

    public function retry(self): number
        self.attempts += 1
        return self.attempts
    end
end

const first = Config()
const second = Config { retries = 5, name = "custom" }
table.insert(first.tags, "extra")

print(first.retries, second.retries, second.name)
print(#first.tags, #second.tags)
print(first.tags[1], second.tags[1])

const service = Service(first)
print(service:retry(), service:retry(), service.config.name)
print(class.isinstance(service, Service), class.isinstance(service, Config))
print(class.name(service), class.name(second))

const empty = Config { }
print(empty.retries, empty.name, #empty.tags)
