if
    const a = 5
    when a > 3
    when const b = a * 2
    when b > 5
then
    print(a, b)
else
    print("no")
end

if const x = 0 then
    print("zero truthy", x)
else
    print("zero falsy")
end

const jobs = { 1, 2, 3, 4 }
while const job = table.remove(jobs, 1) when job ~= 3 do
    print(job)
end

const function maybe(flag: boolean): number | none
    if flag then
        return none
    end
    return 1
end

const function guarded(flag: boolean): string
    const value = do
        const inner = maybe(flag) or return "early"
        print("after guard")
        give inner
    return `value {value}`
end
print(guarded(false))
print(guarded(true))

print(1_000)
