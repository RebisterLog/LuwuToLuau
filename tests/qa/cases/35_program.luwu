trait Describable
    expect const name: string
    expect function details(self): string
    function describe(self): string
        return `{self.name}: {self:details()}`
    end
end

trait Lootable
    expect loot: { string }
    function drop(self): { string }
        const dropped = self.loot
        self.loot = {}
        return dropped
    end
end

class Monster(public const name: string, public hp: number, public loot: { string }) implements Describable, Lootable
    public function details(self): string
        return `{self.hp} hp`
    end
    public function __tostring(self): string
        return self.name
    end
end

class Chest(public loot: { string }) implements Lootable end

const monsters = {
    Monster("Slime", 5, { "goo", "jelly" }),
    Monster("Bat", 2, { "wing" }),
    Monster("Dragon", 100, { "scale", "tooth", "gold" }),
}
const chest = Chest({ "map", "coin" })

const function summary(things: { read Lootable })
    const names = { for _, t in things give tostring(t) }
    const loot_count = do
        local total = 0
        for _, t in things do
            total += #t:drop()
        end
        give total
    return table.concat(names, ", "), loot_count
end

print(summary(monsters))
print(#chest:drop(), #chest:drop())
print(monsters[1]:describe())

const levels = { for _, m in monsters when m.hp > 5 give m.name }
print(table.concat(levels, ","))

const total_hp = do
    local sum = 0
    for _, m in monsters do
        sum += m.hp
    end
    give sum
print(total_hp)
