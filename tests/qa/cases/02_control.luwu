const score = 72
if score >= 90 then
    print("A")
elseif score >= 70 then
    print("B")
else
    print("Keep practicing")
end

if 0 then
    print("0 counts as true")
end
if "" then
    print("so does an empty string")
end

const health = 25
const status = if health > 50 then "healthy" elseif health > 0 then "hurt" else "down"
print(status)

for i = 1, 3 do
    print(i)
end
for i = 10, 0, -5 do
    print(i)
end

local countdown = 3
while countdown > 0 do
    print(countdown)
    countdown -= 1
end
print("liftoff")

const rolls = { 2, 5, 6, 3 }
local tries = 0
repeat
    tries += 1
    const roll = rolls[tries]
until roll == 6
print(`rolled a 6 on try {tries}`)

for i = 1, 10 do
    if i % 2 == 0 then
        continue
    end
    if i > 7 then
        break
    end
    print(i)
end
