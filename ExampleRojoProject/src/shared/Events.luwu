-- Events.luwu — обёртки над RemoteEvent, одинаковые для сервера и клиента.
--
-- Скрипты не знают, где лежит RemoteEvent: его передают снаружи, поэтому
-- модуль можно использовать и на сервере, и на клиенте.

-- Трейт описывает «канал»: он умеет рассказать, готов ли он, и как называется.
trait Channel
    expect function remote(self): Instance

    function is_ready(self): boolean
        return self:remote() ~= nil
    end

    function describe(self): string
        const target = self:remote()
        if target == nil then
            return "channel (missing)"
        end
        return `channel {target.Name}`
    end
end

-- Конкретный канал поверх одного RemoteEvent.
class RemoteChannel(public target: Instance) implements Channel
    public function remote(self): Instance
        return self.target
    end

    -- Сервер отправляет игроку.
    public function fire_client(self, player: Player, payload: { [string]: any })
        self.target:FireClient(player, payload)
    end

    -- Клиент отправляет серверу.
    public function fire_server(self, payload: { [string]: any })
        self.target:FireServer(payload)
    end

    -- Сервер слушает события от игроков.
    public function on_server(self, handler: (Player, { [string]: any }) -> ())
        self.target.OnServerEvent:Connect(handler)
    end

    -- Клиент слушает ответы сервера.
    public function on_client(self, handler: ({ [string]: any }) -> ())
        self.target.OnClientEvent:Connect(handler)
    end
end

-- Реестр каналов: POD-класс с дефолтами и перебором всех каналов.
class ChannelRegistry
    public channels: { [string]: RemoteChannel } = {}

    public function add(self, name: string, channel: RemoteChannel)
        self.channels[name] = channel
    end

    public function get(self, name: string): RemoteChannel?
        const channel = self.channels[name]
        if channel == nil then
            return none
        end
        return channel
    end

    public function names(self): { string }
        const list = { for name, _ in self.channels give name }
        return list
    end
end

-- Собирает реестр из таблицы «имя -> RemoteEvent».
const function build_registry(remotes: { [string]: Instance }): ChannelRegistry
    const registry = ChannelRegistry()
    for name, remote in remotes do
        registry:add(name, RemoteChannel(remote))
    end
    return registry
end

return {
    Channel = Channel,
    RemoteChannel = RemoteChannel,
    ChannelRegistry = ChannelRegistry,
    build_registry = build_registry,
}
