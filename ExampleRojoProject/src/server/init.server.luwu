-- Серверный скрипт: принимает действия игроков, отвечает через RemoteEvent
-- и работает с объектами, пришедшими из rojo.model.json.

const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const Workspace = game:GetService("Workspace")

const Types = require(ReplicatedStorage.Shared.Types)
const Events = require(ReplicatedStorage.Shared.Events)
const Config = require(ReplicatedStorage.Shared.Config)

const settings = Config.default_settings()
const rules = Config.default_rules()

-- Каналы лежат в ReplicatedStorage/Network (см. src/network/Network.model.json).
const network = ReplicatedStorage:WaitForChild("Network")
const action_channel = Events.RemoteChannel(network:WaitForChild("PlayerAction"))
const feedback_channel = Events.RemoteChannel(network:WaitForChild("Feedback"))

-- Состояние игрока: трейты живут в общем модуле, поэтому класс собирает
-- поведение из Types.Health и добавляет своё.
class PlayerState(public player: Player, public vitals: Types.Health)
    public function current_health(self): number
        return self.vitals:current_health()
    end

    public function damage(self, amount: number): number
        const scaled = amount * rules.multiplier_for("fire")
        return self.vitals:damage(scaled)
    end

    public function describe(self): string
        return self.vitals:describe()
    end
end

const states: { [Player]: PlayerState } = {}

const function state_for(player: Player): PlayerState
    const existing = states[player]
    if existing ~= nil then
        return existing
    end
    const created = PlayerState(player, Types.Health(settings.max_health))
    states[player] = created
    return created
end

-- Разбор действия игрока: `try` превращает ошибку в Err, а не роняет сервер.
const function handle_action(player: Player, payload: { [string]: any })
    const action = payload.action
    if action == nil then
        return
    end

    const parsed = try Types.parse_amount(payload.amount or "0")
    if parsed is Err.(problem) then
        feedback_channel:fire_client(player, { kind = "error", message = tostring(problem) })
        return
    end

    if parsed is Ok.(amount) then
        const state = state_for(player)
        const left = state:damage(amount)
        feedback_channel:fire_client(player, { kind = "damage", left = left })
    end
end

-- Модель из src/world/Arena.model.json уже лежит в Workspace.
const arena = Workspace:FindFirstChild("Arena")

const function setup_arena()
    if arena == nil then
        return
    end
    const spawn = arena:FindFirstChild("Spawn")
    if spawn ~= nil then
        spawn:SetAttribute("Ready", true)
    end
end

-- Объект, созданный прямо из кода.
const function create_beacon(): Part
    const beacon = Instance.new("Part")
    beacon.Name = "Beacon"
    beacon.Anchored = true
    beacon.Size = Vector3.new(4, 4, 4)
    beacon.Color = Color3.fromRGB(255, 170, 0)
    beacon.Position = Vector3.new(0, 3, 0)
    beacon.Parent = Workspace
    return beacon
end

setup_arena()
const beacon = create_beacon()

Players.PlayerAdded:Connect(function(player: Player)
    const state = state_for(player)
    const description = state:describe()
    print(`[server] {player.Name} -> {description}`)
end)

Players.PlayerRemoving:Connect(function(player: Player)
    states[player] = nil
end)

action_channel:on_server(handle_action)

const channel_description = action_channel:describe()
print(`[server] ready: {channel_description}, beacon: {beacon.Name}`)
