class Profile(
    public const name: string,
    public nickname: string? = nil,
    private password: string = ""
)
    public level = 1

    public function rename(self, nickname: string)
        self.nickname = nickname
    end

    public function check(self, attempt: string): boolean
        return attempt == self.password
    end
end

const function greeting(person: Profile): string
    return `hi {person.name}`
end

const ada = Profile("Ada")
ada:rename("the countess")
print(greeting(ada), ada.nickname, ada.level, ada:check(""))
