class Circle(public radius: number) end
class Square(public side: number) end

const function area(shape: Circle | Square): number
    if class.isinstance(shape, Circle) then
        return math.pi * shape.radius ^ 2
    end
    return shape.side ^ 2
end

print(area(Circle(1)))
print(area(Square(3)))
print(class.isinstance(Circle(1), Square))
print(class.isinstance("circle", Circle))
