class Box<T>(value: T)
    function get(self): T
        return self.value
    end

    function unwrap_or(self, fallback: T): T
        if self.value ~= nil then
            return self.value
        end
        return fallback
    end
end

const numbers = Box(10)
const words = Box("hi")

print(numbers:get(), words:get())
print(numbers:unwrap_or(0), words:unwrap_or("empty"))

class Pair<A, B>(first: A, second: B)
    function swap(self): Pair<B, A>
        return Pair(self.second, self.first)
    end
end

const swapped = Pair(1, "one"):swap()
print(swapped.first, swapped.second)
