trait Shape
    expect function area(self): number
    expect function describe(self): string
end

class Circle implements Shape
    const kind = "circle"
    radius = 0

    function __init(self, radius: number)
        self.radius = radius
    end

    function area(self): number
        return math.pi * self.radius ^ 2
    end

    function describe(self): string
        return `circle with radius {self.radius}`
    end
end

class Rect implements Shape
    const kind = "rect"
    width = 0
    height = 0

    function __init(self, width: number, height: number)
        self.width = width
        self.height = height
    end

    function area(self): number
        return self.width * self.height
    end

    function describe(self): string
        return `rect {self.width}x{self.height}`
    end
end

const shapes: { Shape } = { Circle(1), Rect(2, 3) }

for _, shape in shapes do
    print(shape.kind, shape:describe(), shape:area())
end
