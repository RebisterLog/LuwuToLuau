const function greet(name: string, greeting = "Hello")
    print(`{greeting}, {name}!`)
end

greet("Ada")
greet("Grace", "Welcome")

class Window(width: number = 800, height: number = 600, title = "Untitled")
    function describe(self): string
        return `{self.title} ({self.width}x{self.height})`
    end
end

print(Window():describe())
print(Window(1024, 768):describe())
print(Window(1024, 768, "Editor"):describe())
