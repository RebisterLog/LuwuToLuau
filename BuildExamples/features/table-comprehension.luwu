const numbers = { 1, 2, 3, 4, 5, 6 }

const even_squares = { for _, n in numbers when n % 2 == 0 give n * n }
print(#even_squares, even_squares[1], even_squares[3])

const fruits = { "apple", "kiwi", "pear", "banana" }

const long_names = { for _, fruit in fruits when #fruit > 3 give string.upper(fruit) }
print(table.concat(long_names, ", "))

const people = {
    { name = "Ada", age = 36 },
    { name = "Grace", age = 17 },
    { name = "Alan", age = 41 },
}

const adults = { for _, person in people when person.age >= 18 give person.name }
print(table.concat(adults, ", "))
